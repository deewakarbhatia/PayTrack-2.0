
pipeline {
    agent any

    options {
        timestamps()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Validate Project Structure') {
            steps {
                sh '''
                    test -d backend
                    test -d frontend
                    test -d infrastructure
                    test -d monitoring
                    test -f docker-compose.yml
                    test -f README.md
                '''
            }
        }

        stage('Backend Syntax Check') {
            steps {
                sh '''
                    find backend/src -name "*.js" -exec node --check {} \\;
                '''
            }
        }

        stage('Frontend Lint') {
            steps {
                dir('frontend') {
                    sh '''
                        npm ci
                        npm run lint
                    '''
                }
            }
        }

        stage('Frontend Production Build') {
            steps {
                dir('frontend') {
                    sh 'npm run build'
                }
            }
        }

        stage('Success') {
            steps {
                echo 'PayTrack 2.0 CI pipeline completed successfully!'
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: All CI checks passed.'
        }
        failure {
            echo 'FAILURE: Check Jenkins Console Output.'
        }
    }
}
